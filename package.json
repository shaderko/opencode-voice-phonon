{
  "name": "opencode-voice-phonon",
  "version": "0.1.0",
  "description": "Local, offline voice prompts for OpenCode, powered by Phonon-2.5",
  "type": "module",
  "license": "MIT",
  "author": "shaderko",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./rpc": "./src/rpc.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "bin",
    "dist",
    "docs",
    "examples",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "voice",
    "speech-to-text",
    "phonon",
    "rust"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:gui": "vite build",
    "prepack": "npm run build:gui",
    "build:native": "cargo build --release --manifest-path native/Cargo.toml",
    "package:native": "node scripts/package-native.mjs",
    "check:binaries": "node scripts/check-binaries.mjs"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.1"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.7.0",
    "@opentui/solid": ">=0.7.0",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/client": "^2.2.1",
    "@opentui/core": "0.7.0",
    "@opentui/solid": "0.7.0",
    "@types/node": "^22.0.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.0",
    "effect": "4.0.1",
    "@opencode/theme": "2.2.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaderko/opencode-voice-phonon.git"
  },
  "homepage": "https://github.com/shaderko/opencode-voice-phonon#readme",
  "bugs": {
    "url": "https://github.com/shaderko/opencode-voice-phonon/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
